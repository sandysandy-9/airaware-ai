# AirAware AI — Environment Configuration Example
# Copy this file to .env and configure the appropriate variables.

# FastAPI Backend Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Assistant Service (Optional)
# If left blank, the application operates with 100% functionality using the verified
# deterministic CPCB rules engine without external API calls or hallucination risk.
GEMINI_API_KEY=your_gemini_api_key_here

# External Station API Tokens (Optional)
# If provided, station-specific feeds from WAQI or OpenAQ can be activated.
# Default zero-config provider uses verified Open-Meteo Copernicus CAMS data.
WAQI_API_TOKEN=your_waqi_api_token_here
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
